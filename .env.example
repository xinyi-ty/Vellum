# Server
PORT=3001
RELOAD=true
CORS_ORIGINS=http://localhost:5173

# Model provider: anthropic or openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_BASE=https://api.anthropic.com
LLM_API_KEY=

# true uses deterministic local responses without calling a model API.
# An empty API key also enables mock mode for local development.
USE_MOCK=true
